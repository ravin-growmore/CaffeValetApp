# ── Razorpay ──────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* for test mode, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_CURRENCY=INR

# ── App Identity (Webhook Guard) ───────────────────────────────
# Unique identifier for this valet app instance.
# Stamped into every Razorpay order note at create-order time.
# The webhook verifies this value to ignore payments from other
# valet apps sharing the same Razorpay account.
# Example values: caffequattroandheri | bennecafe | cafequatro2
APP_ID=caffequattroandheri

# ── GrowMore Central Admin Panel Integration ───────────────────
# Read-only API key for the /api/public-data/* routes.
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')|Write-Host"
# Keep this secret — treat it like a password.
PUBLIC_DATA_API_KEY=3243d02a45f3249b06422d7924840f568105c58fec4e437c597a8744d5f3bc77

# URL of the GrowMore Central Admin Panel (added to CORS allowed origins).
ADMIN_PANEL_URL=https://growmore-admin.example.com

# Human-readable name for this client app (returned in /health and /summary).
APP_NAME=Caffe Quattro Andheri

